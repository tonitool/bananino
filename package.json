{
  "name": "bananino",
  "version": "1.1.0",
  "description": "A 3D desktop buddy for macOS that takes notes, tracks time, and remembers your clipboard.",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "build": "node scripts/build-native.mjs && node scripts/build-renderer.mjs",
    "watch": "node scripts/build-renderer.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "icon": "electron scripts/make-app-icon.mjs",
    "dist": "npm run build && electron-builder --mac",
    "test": "node --test test/*.test.mjs",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "optimise-model": "node scripts/optimise-model.mjs",
    "bake-dance": "node scripts/bake-dance.mjs",
    "bake-garment": "node scripts/bake-garment.mjs",
    "release": "npm run build && electron-builder --mac --publish always",
    "verify": "npm run build && node scripts/verify.mjs",
    "verify:packaged": "node scripts/verify.mjs packaged",
    "radio-textures": "node scripts/prepare-radio-textures.mjs",
    "verify:assets": "node scripts/verifyAssets.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1"
  },
  "build": {
    "appId": "de.clueone.bananino",
    "productName": "Bananino",
    "afterPack": "scripts/afterPack.mjs",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "assets/trayTemplate*.png",
      "package.json"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Bananino asks Music and Spotify what is playing, so it can show the track on your desktop.",
        "NSAudioCaptureUsageDescription": "Bananino records what your meeting participants say, so it can transcribe the meeting on this Mac.",
        "NSMicrophoneUsageDescription": "Bananino records your voice during a meeting, so it can transcribe the meeting on this Mac."
      },
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "copyright": "Copyright © 2026 Clue One",
    "dmg": {
      "title": "Bananino",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ]
  },
  "author": {
    "name": "Clue One"
  },
  "homepage": "https://github.com/tonitool/bananino",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonitool/bananino.git"
  }
}
