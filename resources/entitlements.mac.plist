<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron runs a JIT, which the hardened runtime blocks without these. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
      The three below only start to matter once the app is signed with a Developer ID:
      an ad-hoc signature is not subject to the hardened runtime's resource restrictions,
      so the app worked without them and would have broken the moment it was signed for
      real. Each one is the entitlement for a thing the app already does.
    -->

    <!-- Recording a meeting: the microphone, and the Core Audio tap on system output. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Asking Music and Spotify what is playing, via osascript — see src/main/music. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
